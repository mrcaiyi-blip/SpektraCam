<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="SpektraCam" android:icon="@drawable/ic_spektracam" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:supportsRtl="true">
        <activity
            android:name=".CaptureGalleryActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".FilmSettingsActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
